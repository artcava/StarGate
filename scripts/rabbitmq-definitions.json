{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "users": [
    {
      "name": "stargate",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "stargate"
    }
  ],
  "permissions": [
    {
      "user": "stargate",
      "vhost": "stargate",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "stargate.processes",
      "vhost": "stargate",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-max-length": 100000,
        "x-overflow": "reject-publish"
      }
    }
  ],
  "exchanges": [],
  "bindings": []
}
