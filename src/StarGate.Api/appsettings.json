{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PublisherConfirms": true,
    "PublisherConfirmTimeoutMs": 5000,
    "Enabled": true,
    "ProcessExchange": "stargate.processes",
    "DeadLetterExchange": "stargate.dlx",
    "DeadLetterQueue": "stargate.dlq",
    "MaxRecoveryAttempts": 10,
    "NetworkRecoveryIntervalSeconds": 10,
    "HeartbeatSeconds": 60,
    "ConnectionTimeoutSeconds": 30
  },
  "HealthChecks": {
    "RabbitMQ": {
      "Enabled": true,
      "FailureStatus": "Degraded",
      "Tags": ["message-broker", "rabbitmq"]
    }
  },
  "PolicyProvider": {
    "CacheTtlMinutes": 60,
    "CacheRefreshIntervalMinutes": 30,
    "EnableCacheWarmup": true,
    "EnableBackgroundRefresh": true,
    "MaxMemoryCacheSize": 1000,
    "DefaultTimeoutSeconds": 300,
    "DefaultMaxRetryAttempts": 3,
    "DefaultRetryDelaySeconds": 5,
    "DefaultRetentionDays": 30,
    "DefaultMaxConcurrentProcesses": 10,
    "DefaultBackoffStrategy": "Exponential"
  }
}
