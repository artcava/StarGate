{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "StarGate": "Debug"
    }
  },
  "Retry": {
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 300,
    "BackoffMultiplier": 2.0,
    "UseJitter": true
  },
  "Resilience": {
    "Retry": {
      "MaxRetryAttempts": 3,
      "InitialDelaySeconds": 1.0,
      "MaxDelaySeconds": 30.0,
      "BackoffMultiplier": 2.0,
      "UseJitter": true
    }
  }
}
