# StarGate Local Development Environment Variables
# Copy this file to .env and customize as needed

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=stargate_admin
MONGO_INITDB_ROOT_PASSWORD=stargate_password_dev
MONGO_INITDB_DATABASE=stargate

# Redis Configuration
REDIS_PASSWORD=stargate_redis_password_dev

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=stargate
RABBITMQ_DEFAULT_PASS=stargate_rabbitmq_password_dev
RABBITMQ_DEFAULT_VHOST=stargate

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development

# Authentication Configuration
# TODO: Configure with your actual identity provider
AUTH_AUTHORITY=https://your-identity-provider.com
AUTH_AUDIENCE=stargate-api

# Note: These are development credentials only.
# NEVER use these credentials in production!
