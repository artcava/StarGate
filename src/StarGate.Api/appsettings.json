{
  "RateLimit": {
    "Enabled": true,
    "DefaultPolicy": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "UseSlidingWindow": true
    },
    "EndpointPolicies": {
      "CreateProcess": {
        "PermitLimit": 100,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "UseSlidingWindow": true
      },
      "ReadProcess": {
        "PermitLimit": 500,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "UseSlidingWindow": true
      }
    }
  },
  "Jwt": {
    "Issuer": "https://stargate-api.example.com",
    "Audience": "stargate-api",
    "SecretKey": "your-secret-key-min-32-characters-long-for-development",
    "RequireHttpsMetadata": false,
    "ValidateLifetime": true,
    "ClockSkew": "00:05:00"
  },
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017/stargate",
    "Redis": "localhost:6379",
    "RabbitMQ": "amqp://guest:guest@localhost:5672"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Information"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PublisherConfirms": true,
    "PublisherConfirmTimeoutMs": 5000,
    "Enabled": true,
    "ProcessExchange": "stargate.processes",
    "DeadLetterExchange": "stargate.dlx",
    "DeadLetterQueue": "stargate.dlq",
    "MaxRecoveryAttempts": 10,
    "NetworkRecoveryIntervalSeconds": 10,
    "HeartbeatSeconds": 60,
    "ConnectionTimeoutSeconds": 30
  },
  "HealthChecks": {
    "RabbitMQ": {
      "Enabled": true,
      "FailureStatus": "Degraded",
      "Tags": ["message-broker", "rabbitmq"]
    }
  },
  "PolicyProvider": {
    "CacheTtlMinutes": 60,
    "CacheRefreshIntervalMinutes": 30,
    "EnableCacheWarmup": true,
    "EnableBackgroundRefresh": true,
    "MaxMemoryCacheSize": 1000,
    "DefaultTimeoutSeconds": 300,
    "DefaultMaxRetryAttempts": 3,
    "DefaultRetryDelaySeconds": 5,
    "DefaultRetentionDays": 30,
    "DefaultMaxConcurrentProcesses": 10,
    "DefaultBackoffStrategy": "Exponential"
  }
}
